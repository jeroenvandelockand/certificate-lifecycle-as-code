{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^ ]+) depName=(?<depName>[^\\n]+)\\n[A-Z_]+=(?:[^:\\n]+:)?(?<currentValue>v?[0-9][^\\n]*)"
      ]
    }
  ]
}

